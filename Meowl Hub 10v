function MeowlHub:SwitchTab(tabName)
    if self.CurrentTab == tabName then return end

    for name, btn in pairs(self.Tabs) do
        if name == tabName then
            Utility:Tween(btn, {
                BackgroundTransparency = 0,
                BackgroundColor3 = CONFIG.AccentColor,
                TextColor3 = Color3.fromRGB(25, 25, 35)
            }, 0.3)
        else
            Utility:Tween(btn, {
                BackgroundTransparency = 0.5,
                BackgroundColor3 = Color3.fromRGB(35, 35, 50),
                TextColor3 = Color3.fromRGB(180, 180, 200)
            }, 0.3)
        end
    end

    for _, child in pairs(self.ContentFrame:GetChildren()) do
        if child:IsA("Frame") and child.Name ~= "Content" then
            Utility:FadeOut(child, 0.2, function()
                child.Visible = false
            end)
        end
    end

    wait(0.2)

    local newContent = self.ContentFrame:FindFirstChild(tabName .. "Content")
    if newContent then
        newContent.Visible = true
        newContent.BackgroundTransparency = 1
        Utility:FadeIn(newContent, 0.3)
    end

    self.CurrentTab = tabName
end

