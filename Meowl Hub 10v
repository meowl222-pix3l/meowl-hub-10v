-- ═══════════════════════════════════════════════════════════════
function MeowlHub:CreateSettingsTab()
    local content = Instance.new("Frame")
    content.Name = "SettingsContent"
    content.Size = UDim2.new(1, 0, 1, 0)
    content.BackgroundTransparency = 1
    content.Visible = false
    content.Parent = self.ContentFrame

    local scroll = Instance.new("ScrollingFrame")
    scroll.Name = "SettingsScroll"
    scroll.Size = UDim2.new(1, -20, 1, -10)
    scroll.Position = UDim2.new(0, 10, 0, 5)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 3
    scroll.ScrollBarImageColor3 = CONFIG.AccentColor
    scroll.CanvasSize = UDim2.new(0, 0, 0, 800)
    scroll.Parent = content

    local settings = {
        {Name = "🌙 Dark Mode", Type = "toggle", Default = true},
        {Name = "☀️ Light Mode", Type = "toggle", Default = false},
        {Name = "📱 AMOLED Mode", Type = "toggle", Default = false},
        {Name = "🎨 Rainbow Mode", Type = "toggle", Default = false},
        {Name = "✨ Neon Effects", Type = "toggle", Default = false},
        {Name = "🔮 Glassmorphism", Type = "toggle", Default = true},
        {Name = "🎵 Music", Type = "toggle", Default = true},
        {Name = "📊 FPS Counter", Type = "toggle", Default = true},
        {Name = "🔔 Notifications", Type = "toggle", Default = true},
        {Name = "💾 Auto Save", Type = "toggle", Default = true},
    }

    for i, setting in ipairs(settings) do
        local settingCard = Instance.new("Frame")
        settingCard.Size = UDim2.new(1, -20, 0, 50)
        settingCard.Position = UDim2.new(0, 10, 0, 10 + (i - 1) * 60)
        settingCard.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
        settingCard.BorderSizePixel = 0
        settingCard.Parent = scroll

        local cardCorner = Instance.new("UICorner")
        cardCorner.CornerRadius = UDim.new(0, 12)
        cardCorner.Parent = settingCard

        local nameLabel = Instance.new("TextLabel")
        nameLabel.BackgroundTransparency = 1
        nameLabel.Size = UDim2.new(1, -80, 1, 0)
        nameLabel.Position = UDim2.new(0, 15, 0, 0)
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.Text = setting.Name
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.TextSize = 14
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.Parent = settingCard

        local toggleBtn = Instance.new("TextButton")
        toggleBtn.Size = UDim2.new(0, 50, 0, 26)
        toggleBtn.Position = UDim2.new(1, -65, 0, 12)
        toggleBtn.BackgroundColor3 = setting.Default and CONFIG.AccentColor or Color3.fromRGB(50, 50, 70)
        toggleBtn.BorderSizePixel = 0
        toggleBtn.Font = Enum.Font.GothamBold
        toggleBtn.Text = setting.Default and "ON" or "OFF"
        toggleBtn.TextColor3 = setting.Default and Color3.fromRGB(25, 25, 35) or Color3.fromRGB(150, 150, 170)
        toggleBtn.TextSize = 11
        toggleBtn.Parent = settingCard

        local toggleCorner = Instance.new("UICorner")
        toggleCorner.CornerRadius = UDim.new(1, 0)
        toggleCorner.Parent = toggleBtn

        local isOn = setting.Default
        toggleBtn.MouseButton1Click:Connect(function()
            isOn = not isOn
            Utility:Tween(toggleBtn, {
                BackgroundColor3 = isOn and CONFIG.AccentColor or Color3.fromRGB(50, 50, 70),
                TextColor3 = isOn and Color3.fromRGB(25, 25, 35) or Color3.fromRGB(150, 150, 170)
            }, 0.2)
            toggleBtn.Text = isOn and "ON" or "OFF"

            if setting.Name:find("Rainbow") then
                CONFIG.RainbowMode = isOn
            elseif setting.Name:find("Neon") then
                CONFIG.NeonMode = isOn
