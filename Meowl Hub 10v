local Pages = {}
local CurrentPage = nil
local SidebarButtons = {}

local function CreatePage(name)
    local page = Create("ScrollingFrame", {
        Name = name .. "Page",
        Parent = ContentArea,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(1, 0, 1, 0),
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Color3.fromRGB(255, 105, 180),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Visible = false,
        ZIndex = 12,
    })
    Create("UIPadding", {
        Parent = page,
        PaddingLeft = UDim.new(0, 15),
        PaddingRight = UDim.new(0, 15),
        PaddingTop = UDim.new(0, 15),
        PaddingBottom = UDim.new(0, 15),
    })
    Pages[name] = page
    return page
end

local function SwitchPage(pageName)
    if CurrentPage == pageName then return end

    if CurrentPage and Pages[CurrentPage] then
        local oldPage = Pages[CurrentPage]
        Tween(oldPage, {Position = UDim2.new(-0.1, 0, 0, 0), ScrollBarImageTransparency = 1}, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In, function()
            oldPage.Visible = false
            oldPage.Position = UDim2.new(0, 0, 0, 0)
            oldPage.ScrollBarImageTransparency = 0
        end)
    end

    CurrentPage = pageName
    local newPage = Pages[pageName]
    newPage.Position = UDim2.new(0.1, 0, 0, 0)
    newPage.Visible = true
    Tween(newPage, {Position = UDim2.new(0, 0, 0, 0)}, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    -- Update sidebar highlights
    for btnName, btn in pairs(SidebarButtons) do
        if btnName == pageName then
            Tween(btn, {BackgroundColor3 = Color3.fromRGB(255, 105, 180)}, 0.2)
            btn.ImageColor3 = Color3.fromRGB(255, 255, 255)
        else
            Tween(btn, {BackgroundColor3 = Color3.fromRGB(22, 22, 28)}, 0.2)
            btn.ImageColor3 = Color3.fromRGB(150, 150, 170)
        end
    end
end

local function CreateSidebarButton(name, icon, order)
    local btn = Create("ImageButton", {
        Name = name .. "Btn",
        Parent = Sidebar,
        BackgroundColor3 = Color3.fromRGB(22, 22, 28),
        BorderSizePixel = 0,
        Position = UDim2.new(0.5, -18, 0, 15 + (order * 50)),
        Size = UDim2.new(0, 36, 0, 36),
        AnchorPoint = Vector2.new(0.5, 0),
        Image = icon,
        ImageColor3 = Color3.fromRGB(150, 150, 170),
        ImageRectSize = Vector2.new(36, 36),
        ZIndex = 12,
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 10), Parent = btn})

    SidebarButtons[name] = btn

    btn.MouseEnter:Connect(function()
        if CurrentPage ~= name then
            Tween(btn, {BackgroundColor3 = Color3.fromRGB(40, 40, 55)}, 0.2)
        end
    end)

    btn.MouseLeave:Connect(function()
        if CurrentPage ~= name then
            Tween(btn, {BackgroundColor3 = Color3.fromRGB(22, 22, 28)}, 0.2)
        end
    end)

    btn.MouseButton1Click:Connect(function()
        Ripple(btn, Mouse.X, Mouse.Y)
        SwitchPage(name)
    end)

    return btn
end

