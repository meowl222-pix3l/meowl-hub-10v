        local msgFrame = Instance.new("Frame")
        msgFrame.Size = UDim2.new(1, -20, 0, 30)
        msgFrame.Position = UDim2.new(0, 10, 0, chatScroll.CanvasSize.Y.Offset - 10)
        msgFrame.BackgroundTransparency = 1
        msgFrame.Parent = chatScroll

