        msgLabel.BackgroundTransparency = 1
        msgLabel.Size = UDim2.new(1, 0, 0, 30)
        msgLabel.Position = UDim2.new(0, 0, 0, 0)
        msgLabel.Font = Enum.Font.Gotham
        msgLabel.Text = (isUser and "👤 You: " or "🌌 AI: ") .. text
        msgLabel.TextColor3 = isUser and Color3.fromRGB(150, 200, 255) or Color3.fromRGB(200, 180, 255)
        msgLabel.TextSize = 12
        msgLabel.TextWrapped = true
        msgLabel.TextYAlignment = Enum.TextYAlignment.Top
        msgLabel.TextXAlignment = Enum.TextXAlignment.Left
        msgLabel.Parent = msgFrame

        chatScroll.CanvasSize = UDim2.new(0, 0, 0, chatScroll.CanvasSize.Y.Offset + 40)
        chatScroll.CanvasPosition = Vector2.new(0, chatScroll.CanvasSize.Y.Offset)
    end

    local function processAI(input)
        input = input:lower()
        for keyword, response in pairs(aiResponses) do
            if input:find(keyword) then
                return response
            end
        end
        return "I'm still learning! Try asking about scripts, fly, speed, noclip, ESP, aimbot, admin, or dex. Or visit our Discord for more help!"
    end

    local function sendMessage()
        local text = aiInput.Text
        if text ~= "" then
            addMessage(text, true)
            aiInput.Text = ""
            wait(0.5)
            addMessage(processAI(text), false)
        end
    end

    sendBtn.MouseButton1Click:Connect(sendMessage)
    aiInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            sendMessage()
        end
    end)
end

