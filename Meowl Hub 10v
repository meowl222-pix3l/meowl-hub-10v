-- ═══════════════════════════════════════════════════════════════
-- MINIMIZE / CLOSE
-- ═══════════════════════════════════════════════════════════════
function MeowlHub:ToggleMinimize()
    self.IsMinimized = not self.IsMinimized

    if self.IsMinimized then
        Utility:Tween(self.MainFrame, {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0)
        }, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In)

        if self.BlurEffect then
            Utility:Tween(self.BlurEffect, {Size = 0}, 0.3)
        end

        wait(0.4)
        self.MainFrame.Visible = false
        self.FloatingButton.Visible = true

        Utility:Tween(self.FloatingButton, {Size = UDim2.new(0, 55, 0, 55)}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    else
        self.FloatingButton.Visible = false
        self.MainFrame.Visible = true

        local targetSize = UDim2.new(0, 900, 0, 600)
        if UserInputService.TouchEnabled then
            targetSize = UDim2.new(0, 700, 0, 500)
        end

        Utility:Tween(self.MainFrame, {
            Size = targetSize,
            Position = UDim2.new(0.5, -targetSize.X.Offset/2, 0.5, -targetSize.Y.Offset/2)
        }, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

        if self.BlurEffect then
            Utility:Tween(self.BlurEffect, {Size = 8}, 0.3)
        end
    end
end

function MeowlHub:Close()
    self.IsClosed = true

    Utility:Tween(self.MainFrame, {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0)
    }, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In, function()
        self.GUI:Destroy()
        if self.BlurEffect then
            self.BlurEffect:Destroy()
        end
    end)
end

-- ═══════════════════════════════════════════════════════════════
-- MOBILE OPTIMIZATION
-- ═══════════════════════════════════════════════════════════════
function MeowlHub:SetupMobile()
    if not UserInputService.TouchEnabled then return end

    -- Larger touch targets
    for _, btn in pairs(self.GUI:GetDescendants()) do
        if btn:IsA("TextButton") then
            local currentSize = btn.Size
            btn.Size = UDim2.new(currentSize.X.Scale, currentSize.X.Offset + 10, currentSize.Y.Scale, currentSize.Y.Offset + 10)
        end
    end

    -- Pinch to resize
    local initialDistance = nil
    local initialSize = nil

    UserInputService.TouchStarted:Connect(function(touch, gameProcessed)
        if not gameProcessed then
            local touches = UserInputService:GetTouches()
            if #touches == 2 then
                initialDistance = (touches[1].Position - touches[2].Position).Magnitude
                initialSize = self.MainFrame.Size
            end
        end
    end)

    UserInputService.TouchMoved:Connect(function(touch, gameProcessed)
        if not gameProcessed then
            local touches = UserInputService:GetTouches()
            if #touches == 2 and initialDistance then
                local currentDistance = (touches[1].Position - touches[2].Position).Magnitude
                local scale = currentDistance / initialDistance
                local newSize = UDim2.new(0, math.clamp(initialSize.X.Offset * scale, 400, 1200), 0, math.clamp(initialSize.Y.Offset * scale, 300, 800))
                self.MainFrame.Size = newSize
            end
        end
    end)

    UserInputService.TouchEnded:Connect(function()
        initialDistance = nil
        initialSize = nil
    end)
end

