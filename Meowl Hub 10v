-- ═══════════════════════════════════════════════════════════════
function MeowlHub:CreateNotifications()
    self.NotificationFrame = Instance.new("Frame")
    self.NotificationFrame.Name = "Notifications"
    self.NotificationFrame.Size = UDim2.new(0, 320, 1, 0)
    self.NotificationFrame.Position = UDim2.new(1, 0, 0, 0)
    self.NotificationFrame.BackgroundTransparency = 1
    self.NotificationFrame.Parent = self.GUI

    self.NotificationList = Instance.new("UIListLayout")
    self.NotificationList.Padding = UDim.new(0, 10)
    self.NotificationList.HorizontalAlignment = Enum.HorizontalAlignment.Right
    self.NotificationList.VerticalAlignment = Enum.VerticalAlignment.Bottom
    self.NotificationList.Parent = self.NotificationFrame
end

function MeowlHub:ShowNotification(message, notifType)
    notifType = notifType or "info"

    local colors = {
        success = Color3.fromRGB(80, 200, 120),
        error = Color3.fromRGB(255, 100, 100),
        warning = Color3.fromRGB(255, 200, 100),
        info = Color3.fromRGB(120, 180, 255),
    }

    local icons = {
        success = "✓",
        error = "✗",
        warning = "⚠",
        info = "ℹ",
    }

    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 300, 0, 60)
    notif.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
    notif.BorderSizePixel = 0
    notif.Parent = self.NotificationFrame

    local notifCorner = Instance.new("UICorner")
    notifCorner.CornerRadius = UDim.new(0, 12)
    notifCorner.Parent = notif

    local leftBar = Instance.new("Frame")
    leftBar.Size = UDim2.new(0, 4, 1, 0)
    leftBar.BackgroundColor3 = colors[notifType]
    leftBar.BorderSizePixel = 0
    leftBar.Parent = notif

    local barCorner = Instance.new("UICorner")
    barCorner.CornerRadius = UDim.new(0, 12)
    barCorner.Parent = leftBar

    local iconLabel = Instance.new("TextLabel")
    iconLabel.BackgroundTransparency = 1
    iconLabel.Size = UDim2.new(0, 30, 0, 30)
    iconLabel.Position = UDim2.new(0, 15, 0, 15)
    iconLabel.Font = Enum.Font.GothamBold
    iconLabel.Text = icons[notifType]
    iconLabel.TextColor3 = colors[notifType]
    iconLabel.TextSize = 20
    iconLabel.Parent = notif

    local messageLabel = Instance.new("TextLabel")
    messageLabel.BackgroundTransparency = 1
    messageLabel.Size = UDim2.new(1, -60, 0, 40)
    messageLabel.Position = UDim2.new(0, 50, 0, 10)
    messageLabel.Font = Enum.Font.Gotham
    messageLabel.Text = message
    messageLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    messageLabel.TextSize = 13
    messageLabel.TextWrapped = true
    messageLabel.TextYAlignment = Enum.TextYAlignment.Center
    messageLabel.Parent = notif

    -- Animate in
    notif.Position = UDim2.new(0, 320, 0, 0)
    Utility:Tween(notif, {Position = UDim2.new(0, 0, 0, 0)}, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    -- Auto remove
    delay(3, function()
        Utility:Tween(notif, {Position = UDim2.new(0, 320, 0, 0)}, 0.3, nil, nil, function()
            notif:Destroy()
        end)
    end)
end

function MeowlHub:ShowWelcomeNotification()
