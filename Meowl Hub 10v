-- PAGE CREATION SYSTEM
-- ═══════════════════════════════════════════════════════════════════════════════
local Pages = {}
local CurrentPage = nil

local function CreatePage(name)
    local page = Create("ScrollingFrame", {
        Parent = PageContainer,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(1, 0, 1, 0),
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Config.AccentColor,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ZIndex = 12,
        Visible = false,
    })

    local layout = Create("UIListLayout", {
        Parent = page,
        Padding = UDim.new(0, 10),
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    Create("UIPadding", {
        Parent = page,
        PaddingTop = UDim.new(0, 15),
        PaddingBottom = UDim.new(0, 15),
        PaddingLeft = UDim.new(0, 15),
        PaddingRight = UDim.new(0, 15),
    })

    Pages[name] = page
    return page
end

local function SwitchPage(pageName)
    if CurrentPage and Pages[CurrentPage] then
        local oldPage = Pages[CurrentPage]
        Tween(oldPage, {Position = UDim2.new(-1, 0, 0, 0)}, 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In, function()
            oldPage.Visible = false
            oldPage.Position = UDim2.new(0, 0, 0, 0)
        end)
    end

    if Pages[pageName] then
        CurrentPage = pageName
        Pages[pageName].Position = UDim2.new(1, 0, 0, 0)
        Pages[pageName].Visible = true
        Tween(Pages[pageName], {Position = UDim2.new(0, 0, 0, 0)}, 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    end
end

